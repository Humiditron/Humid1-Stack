{
    email support@humid1.com

    layer4 {
        :8883 {
            route {
                tls
                proxy thingsboard-ce:1883
            }
        }
    }
}

# Base Security Headers (Safe for Authentik & SSO Apps)
(security-base) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-Permitted-Cross-Domain-Policies "none"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=(), accelerometer=(), gyroscope=()"
        -Server
    }
}

# Add CORS specifically for the ThingsBoard API
(cors) {
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type, X-Authorization"
    }
    @options method OPTIONS
    respond @options 204
}

# Static Web App CSP (Use only on standard static or single-origin web apps)
(app-csp) {
    header {
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss: ws:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:;"
    }
}

www.humid1.com {
    redir https://humid1.com{uri} permanent
}

humid1.com {
    import security-base
    import app-csp
    root * /var/www/html

    @legal path /terms /privacy /community /community-guidelines
    rewrite @legal /legal.html

    file_server
}

# Authentik SSO - Uses base security only (lets Authentik handle CSP)
auth.humid1.com {
    import security-base
	import cors
    reverse_proxy authentik-server:9000
}

app.humid1.com {
    import security-base
    reverse_proxy thingsboard-ce:8080
}

chat.humid1.com {
    import security-base
    reverse_proxy chatto:4000
}

cap.humid1.com {
    import security-base
    reverse_proxy cap:3000
}